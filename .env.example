# One model for both roles (class agents and orchestrator), as in the paper. Every LLM_BIG_* setting
# below falls back to its LLM_* value, so leave them unset to reproduce the paper's setup.
LLM_API_KEY=sk-...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-26b-a4b-it
LLM_BIG_MAX_TOKENS=16000               # the merge writes the whole graph; endpoints cap output by default
LLM_TIMEOUT=600                        # seconds per request; a big agent reply can take minutes
LLM_PROVIDER_SORT=throughput           # OpenRouter only: route to the fastest provider (LLM_BIG_PROVIDER_SORT for the orchestrator)

# Optional: a separate orchestrator (segmentation plan + final merge). Setting these runs the two roles on
# different models, which the paper did not do.
# LLM_BIG_API_KEY=
# LLM_BIG_BASE_URL=
# LLM_BIG_MODEL=

# KGDC_MAX_FIX=2                      # validator-guided fix rounds per agent
# LLM_COST_PER_MTOK=0.05,0.20       # USD per 1M prompt,completion tokens when the endpoint reports no cost (LLM_BIG_COST_PER_MTOK for the orchestrator)
# LLM_TIMEOUT=90                     # seconds per request before retry (hung tool-call responses otherwise block 10 min)
# LLM_MAX_TOKENS=2000                # cap on worker completions
# LLM_BASIC_AUTH=user:password          # HTTP basic auth in front of the endpoint (LLM_BIG_BASIC_AUTH for the orchestrator)
