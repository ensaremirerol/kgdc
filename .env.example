# Workers (class agents)
LLM_API_KEY=sk-...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_PROVIDER_SORT=throughput           # OpenRouter only: route to the fastest provider (LLM_BIG_PROVIDER_SORT for the orchestrator)

# Orchestrator (segmentation plan + final merge). Each unset LLM_BIG_* falls
# back to the LLM_* value, so they may share or differ in endpoint/key/model.
# LLM_BIG_API_KEY=
# LLM_BIG_BASE_URL=
# LLM_BIG_MODEL=openai/gpt-oss-120b

# KGDC_MAX_FIX=2                      # validator-guided fix rounds per agent
# LLM_COST_PER_MTOK=0.05,0.20       # USD per 1M prompt,completion tokens when the endpoint reports no cost (LLM_BIG_COST_PER_MTOK for the orchestrator)
# LLM_TIMEOUT=90                     # seconds per request before retry (hung tool-call responses otherwise block 10 min)
# LLM_MAX_TOKENS=2000                # cap on worker completions
